{
  "rule": "M3",
  "description": "ms 有两个锁定版本；必须给出确定性结论（CONVERGIBLE + 目标 2.1.3 + 每个请求者的满足证明）",
  "mustContain": [
    {
      "path": "dedupe[?package=ms].status",
      "value": "CONVERGIBLE"
    },
    {
      "path": "dedupe[?package=ms].lockedVersions",
      "deepEqual": [
        "2.0.0",
        "2.1.3"
      ]
    },
    {
      "path": "dedupe[?package=ms].targets[0].version",
      "value": "2.1.3"
    },
    {
      "path": "dedupe[?package=ms].targets[0].proof[0].satisfies",
      "value": true
    },
    {
      "path": "dedupe[?package=ms].targets[0].proof[1].satisfies",
      "value": true
    },
    {
      "path": "dedupe[?package=ms].degraded",
      "value": false
    },
    {
      "path": "dedupe[?package=ms].requesters",
      "value": 2
    },
    {
      "path": "input.declarations",
      "value": 2
    },
    {
      "path": "input.packages",
      "value": 5
    }
  ],
  "mustNotContain": [
    {
      "path": "dedupe[?package=ms].minimalConflictSet",
      "present": true
    },
    {
      "path": "dedupe[?package=ms].targets[0].proof[0].satisfies",
      "value": false
    }
  ],
  "exitCode": 0,
  "implementationVersions": {
    "semver": "7.8.5",
    "node": ">=20"
  },
  "sources": [
    "data/README.md §3.1（场景 B：debug@2.6.9→ms@2.0.0、send@0.18.0→ms@2.1.3，npm ls 退出码 0 不告警重复）",
    "data/README.md §7.1（CONVERGIBLE 的定义与输出要求）"
  ]
}
