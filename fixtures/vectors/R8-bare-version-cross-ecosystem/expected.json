{
  "rule": "R8",
  "description": "裸版本在 npm 是精确锁定、在 Cargo 是 caret；默认关闭，--enable-r8 才提示（info）。同族多形态：三个裸版本（1.2.3 / 0.2.3 / 0.0.3）必须报；显式 caret / tilde / = / 范围 / 1.2.x / 两位部分版本（1.2）六种形态都不得报",
  "args": [
    "--enable-r8"
  ],
  "mustContain": [
    {
      "path": "findings[?package=bare].rule",
      "value": "R8"
    },
    {
      "path": "findings[?package=bare].severity",
      "value": "info"
    },
    {
      "path": "findings[?package=bare].expandedRange",
      "value": "1.2.3"
    },
    {
      "path": "findings[?package=bare].evidence",
      "contains": "Cargo"
    },
    {
      "path": "findings[?package=bare-zero].rule",
      "value": "R8"
    },
    {
      "path": "findings[?package=bare-zero].expandedRange",
      "value": "0.2.3"
    },
    {
      "path": "findings[?package=bare-zero-zero].rule",
      "value": "R8"
    },
    {
      "path": "findings[?package=bare-zero-zero].expandedRange",
      "value": "0.0.3"
    },
    {
      "path": "input.declarations",
      "value": 9
    },
    {
      "path": "input.packages",
      "value": 10
    }
  ],
  "mustNotContain": [
    {
      "path": "findings[?package=explicit-caret].rule",
      "value": "R8"
    },
    {
      "path": "findings[?package=explicit-tilde].rule",
      "value": "R8"
    },
    {
      "path": "findings[?package=explicit-eq].rule",
      "value": "R8"
    },
    {
      "path": "findings[?package=explicit-range].rule",
      "value": "R8"
    },
    {
      "path": "findings[?package=explicit-x].rule",
      "value": "R8"
    },
    {
      "path": "findings[?package=partial-two].rule",
      "value": "R8"
    }
  ],
  "exitCode": 0,
  "implementationVersions": {
    "semver": "7.8.5",
    "node": ">=20"
  },
  "sources": [
    "data/README.md §1.1 A15（validRange('1.2.3') = '1.2.3'，无上界）",
    "data/README.md §2（裸 1.2.3：npm 精确 / Cargo >=1.2.3,<2.0.0）",
    "plan/01 §3.1 R8（默认关闭，无法从文件推断作者意图）",
    "plan/03 M1 R8（开启后仅对 ^\\d+\\.\\d+\\.\\d+$ 给提示）"
  ]
}
