{
  "rule": "M2",
  "description": "lockfileVersion 1（npm 6 嵌套 dependencies）：同一条审计路径必须给声明项/范围/锁中版本/请求者路径。覆盖 missing-from-lock（根声明了但锁里没有）+ 传递请求者链 + v1 无可比对根声明（不产生 manifest-changed-unsynced）",
  "mustContain": [
    {
      "path": "input.lockfileVersion",
      "value": 1
    },
    {
      "path": "input.format",
      "value": "v1"
    },
    {
      "path": "input.declarations",
      "value": 2
    },
    {
      "path": "input.packages",
      "value": 3
    },
    {
      "path": "findings[?kind=missing-from-lock&dependency=ghost].declaringPackage",
      "value": "fixture-m3-v1"
    },
    {
      "path": "findings[?kind=missing-from-lock&dependency=ghost].declaredRange",
      "value": "^1.0.0"
    },
    {
      "path": "findings[?kind=missing-from-lock&dependency=ghost].lockedVersion",
      "value": null
    },
    {
      "path": "findings[?kind=missing-from-lock&dependency=ghost].requesterPath",
      "deepEqual": ["<root>"]
    },
    {
      "path": "findings[?kind=missing-from-lock&dependency=ghost].severity",
      "value": "error"
    },
    {
      "path": "findings[?kind=manifest-not-satisfied&dependency=send].lockedVersion",
      "value": "0.18.0"
    },
    {
      "path": "findings[?kind=manifest-not-satisfied&dependency=send].declaredRange",
      "value": "^0.19.2"
    },
    {
      "path": "findings[?kind=manifest-not-satisfied&dependency=ms].requesterPath",
      "deepEqual": ["<root>", "send@0.18.0"]
    },
    {
      "path": "findings[?kind=manifest-not-satisfied&dependency=ms].lockedVersion",
      "value": "2.1.3"
    }
  ],
  "mustNotContain": [
    {
      "path": "findings[?kind=manifest-changed-unsynced]",
      "present": true
    },
    {
      "path": "findings[?kind=lock-extra-undeclared]",
      "present": true
    }
  ],
  "exitCode": 1,
  "implementationVersions": {
    "semver": "7.8.5",
    "node": ">=20"
  },
  "sources": [
    "data/README.md §7.3（missing-from-lock / manifest-not-satisfied 默认 error；退出码 1）",
    "data/README.md §1.1 A2（satisfies('0.2.9','^0.2.3')=true / satisfies('0.3.0','^0.2.3')=false）",
    "plan/03 M2（四类 kind 判据；requesterPath 缺失即缺陷）",
    "plan/01 §3.2（v1 嵌套 dependencies 与 v2/v3 的 packages 混用即输入不可解析）",
    "docs/limitations.md §3.5（v1 无 packages[\"\"]，根声明无可比对基线 → 不产生 manifest-changed-unsynced）"
  ]
}
