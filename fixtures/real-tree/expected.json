{
  "rule": "M4",
  "description": "20 个已安装包的真实树（npm 11.12.1 离线写出）：debug@2.6.9 精确锁定 ms@2.0.0、send@0.18.0 精确锁定 ms@2.1.3 → 不可收敛 + 最小冲突集（两条请求者）",
  "mustContain": [
    { "path": "input.declarations", "value": 3 },
    { "path": "input.packages", "value": 21 },
    { "path": "input.reachable", "value": 20 },
    { "path": "dedupe[?package=ms].status", "value": "NOT_CONVERGIBLE" },
    { "path": "dedupe[?package=ms].lockedVersions", "deepEqual": ["2.0.0", "2.1.3"] },
    { "path": "dedupe[?package=ms].requesters", "value": 2 },
    { "path": "dedupe[?package=ms].reason", "value": "empty-intersection" },
    { "path": "dedupe[?package=ms].degraded", "value": false },
    { "path": "dedupe[?package=ms].minimalConflictSet[0].requester", "value": "<root> › debug@2.6.9" },
    { "path": "dedupe[?package=ms].minimalConflictSet[0].range", "value": "2.0.0" },
    { "path": "dedupe[?package=ms].minimalConflictSet[1].requester", "value": "<root> › send@0.18.0" },
    { "path": "dedupe[?package=ms].minimalConflictSet[1].range", "value": "2.1.3" },
    { "path": "dedupe[?package=ms].minimalConflictSet[1].requesterPath[1]", "value": "send@0.18.0" },
    { "path": "conflicts[?package=ms].kind", "value": "version-conflict" }
  ],
  "mustNotContain": [
    { "path": "dedupe[?package=ms].status", "value": "CONVERGIBLE" },
    { "path": "dedupe[?package=ms].targets[0].version", "present": true },
    { "path": "dedupe[?package=ms].minimalConflictSets", "present": true },
    { "path": "findings[0]", "present": true }
  ],
  "exitCode": 1,
  "implementationVersions": {
    "semver": "7.8.5",
    "node": ">=20"
  },
  "sources": [
    "data/README.md §1.1 A25（本机 npm 11.12.1 `npm install --offline` 写出的 20 包真实树：debug@2.6.9→ms@2.0.0 顶层、send@0.18.0→ms@2.1.3 嵌套；`npm ls --all` 退出码 0）",
    "data/README.md §3.1（场景 B 实测：双 ms 版本并存时 npm ls 不告警）",
    "data/README.md §7.1 / §7.2（三态与最小冲突集口径；`CONVERGIBLE` 必须用实际候选版本实算）",
    "data/README.md §1.1 A15（裸三位版本 = 精确锁定：两个请求者各自钉死不同版本）",
    "plan/01 §3.3（20 包真实树上必须给出确定性结论：可收敛目标 或 不可收敛 + 最小冲突集）"
  ]
}
